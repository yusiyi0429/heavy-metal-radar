/* === 首页 — Death Metal Industrial === */

.title-bar {
  padding: 32px 0 22px;
  border-bottom: 2px solid #1a1a1a;
  margin-bottom: 10px;
  position: relative;
}

/* 底部锈蚀线 */
.title-bar::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2px;
  height: 2px;
  background: linear-gradient(90deg, transparent 0%, #7f1d1d 20%, #c62828 50%, #7f1d1d 80%, transparent 100%);
}

.title {
  font-size: 30px;
  font-weight: 900;
  font-style: italic;
  letter-spacing: 6px;
  color: #dddddd;
  text-shadow: 3px 3px 0 #000000, 0 0 20px rgba(198,40,40,0.35);
  line-height: 1.2;
  display: block;
  margin-bottom: 4px;
}

.subtitle {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 10px;
  color: #555555;
  display: block;
  margin-bottom: 18px;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.city-btn {
  display: flex;
  align-items: center;
  background: #111111;
  border: 1px solid #2a2a2a;
  box-shadow: 2px 2px 0 #000000;
  padding: 8px 14px;
  font-size: 12px;
  font-weight: 700;
  color: #888888;
  letter-spacing: 2px;
}

.arrow {
  color: #ef4444;
  margin-left: 8px;
  font-size: 10px;
}

/* TDesign button override for brutalist style */
.refresh-btn {
  --td-button-danger-bg-color: linear-gradient(180deg, #c62828, #8b1a1a) !important;
  --td-button-danger-border-color: #7f1d1d !important;
  --td-button-danger-color: #eeeeee !important;
  --td-button-border-radius: 0 !important;
  letter-spacing: 4px !important;
  font-weight: 900 !important;
  box-shadow: 3px 3px 0 #000000 !important;
}

.refresh-btn:active {
  transform: translate(1px, 1px) !important;
  box-shadow: 1px 1px 0 #000000 !important;
}

/* Loading */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 180px;
}

.loading-text {
  margin-top: 16px;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 6px;
  color: #444444;
  animation: pulse 1.4s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

/* Empty */
.empty-box {
  padding-top: 140px;
  --td-empty-image-color: #333333;
  --td-empty-description-color: #444444;
}

.empty-action {
  margin-top: 12px;
  text-align: center;
}

.empty-hint {
  font-size: 11px;
  font-weight: 600;
  color: #333333;
  letter-spacing: 2px;
}

/* List wrapper */
.list-wrap {
  padding-top: 6px;
}
