.top-bar {
  padding: 20px 0 12px;
}

.title {
  font-size: 24px;
  font-weight: 800;
  color: var(--accent);
  letter-spacing: 2px;
  margin-bottom: 14px;
}

.filter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.city-picker {
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 6px 14px;
  font-size: 14px;
  color: var(--text-primary);
}

.arrow {
  margin-left: 6px;
  color: var(--text-secondary);
  font-size: 11px;
}

.refresh-btn {
  background: var(--accent);
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  padding: 7px 22px;
  border-radius: 6px;
}

.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120px;
  color: var(--text-secondary);
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 16px;
}

.empty-text {
  font-size: 16px;
  margin-bottom: 8px;
}

.empty-hint {
  font-size: 13px;
  color: #555;
}

.show-list {
  padding-top: 12px;
}

.refresh-indicator {
  text-align: center;
  padding: 12px;
  color: var(--text-secondary);
  font-size: 12px;
}
