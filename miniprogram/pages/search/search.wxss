/* === 搜索页 — Brutal Industrial === */

.search-bar {
  display: flex;
  align-items: flex-start;
  padding: 24px 0 18px;
  gap: 12px;
}

.search-input {
  flex: 1;
  --td-input-bg-color: #111111;
  --td-input-border-color: #2a2a2a;
  --td-input-text-color: #cccccc;
}

.search-input-inner {
  border: 1px solid #2a2a2a !important;
  box-shadow: 2px 2px 0 #000000;
  font-weight: 600;
  letter-spacing: 1px;
}

.search-placeholder {
  color: #555;
}

.search-btn {
  --td-button-danger-bg-color: #c62828 !important;
  --td-button-danger-border-color: #7f1d1d !important;
  --td-button-danger-color: #eeeeee !important;
  --td-button-border-radius: 0 !important;
  letter-spacing: 4px !important;
  font-weight: 900 !important;
  box-shadow: 3px 3px 0 #000000 !important;
}

.search-btn:active {
  transform: translate(1px, 1px) !important;
  box-shadow: 1px 1px 0 #000000 !important;
}

.filter-row {
  padding: 10px 0 22px;
  border-bottom: 1px solid #1a1a1a;
  margin-bottom: 10px;
}

.filter-switch {
  --td-switch-label-color: #777777;
}

.filter-label {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2px;
}

.empty-box {
  padding-top: 160px;
  --td-empty-image-color: #333333;
  --td-empty-description-color: #444444;
}

.show-list {
  padding-top: 4px;
}
