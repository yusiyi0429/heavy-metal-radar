<view class="container">
  <view class="search-bar">
    <t-input
      t-class="search-input"
      t-class-input="search-input-inner"
      placeholder="搜索艺人名、城市..."
      placeholder-class="search-placeholder"
      value="{{query}}"
      bind:change="onInput"
      confirm-type="search"
      clearable
      focus
    />
    <t-button
      t-class="search-btn"
      theme="danger"
      size="small"
      bindtap="onSearch"
      loading="{{searching}}"
    >
      搜索
    </t-button>
  </view>

  <view class="filter-row">
    <t-switch
      label="仅显示可购票"
      value="{{onlyOnSale}}"
      bind:change="onToggleFilter"
      t-class="filter-switch"
      t-class-label="filter-label"
    />
  </view>

  <t-empty
    wx:if="{{searched && shows.length === 0}}"
    icon="search"
    description="未找到匹配演出"
    size="small"
    class="empty-box"
  />

  <view class="show-list">
    <show-card wx:for="{{shows}}" wx:key="_id" show="{{item}}" />
  </view>
</view>
