/* === 设置页 — Industrial Metal === */

.section {
  margin-top: 30px;
}

.section-title {
  font-size: 11px;
  font-weight: 900;
  color: #555555;
  letter-spacing: 6px;
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 1px solid #1e1e1e;
  position: relative;
}

/* 红色下划线短标 */
.section-title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 44px;
  height: 2px;
  background: linear-gradient(90deg, #c62828, transparent);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 14px;
}

.tag {
  display: flex;
  align-items: center;
  background: #111111;
  border: 1px solid #2a2a2a;
  box-shadow: 1px 2px 0 #000000;
  padding: 5px 12px;
  margin-right: 8px;
  margin-bottom: 8px;
  font-size: 12px;
  font-weight: 600;
  color: #999999;
  letter-spacing: 1px;
}

.tag-remove {
  margin-left: 10px;
  color: #ef4444;
  font-size: 14px;
  font-weight: 900;
}

.add-row {
  display: flex;
}

.add-input {
  flex: 1;
  background: #111111;
  border: 1px solid #2a2a2a;
  box-shadow: 1px 2px 0 #000000;
  padding: 9px 14px;
  font-size: 13px;
  font-weight: 500;
  color: #cccccc;
  letter-spacing: 1px;
}

.add-btn {
  background: #1a1a1a;
  border: 1px solid #2a2a2a;
  box-shadow: 2px 3px 0 #000000;
  color: #888888;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
  padding: 9px 16px;
  margin-left: 8px;
  white-space: nowrap;
}

.add-btn:active {
  background: #7f1d1d;
  border-color: #7f1d1d;
  color: #ffffff;
  transform: translate(1px, 1px);
  box-shadow: 1px 1px 0 #000000;
}

.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #0e0e0e;
  border: 1px solid #1e1e1e;
  box-shadow: 2px 3px 0 #000000;
  padding: 16px;
  font-size: 13px;
  font-weight: 700;
  color: #999999;
  letter-spacing: 1px;
}

.save-btn {
  margin-top: 40px;
  background: linear-gradient(180deg, #c62828, #8b1a1a);
  border: 1px solid #7f1d1d;
  box-shadow: 4px 4px 0 #000000;
  color: #eeeeee;
  text-align: center;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: 6px;
  padding: 16px;
}

.save-btn:active {
  background: #991b1b;
  transform: translate(2px, 2px);
  box-shadow: 1px 1px 0 #000000;
}

.danger-btn {
  margin-top: 14px;
  background: transparent;
  border: 1px solid #4a1515;
  box-shadow: 2px 3px 0 #000000;
  color: #c62828;
  text-align: center;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 4px;
  padding: 14px;
}

.danger-btn:active {
  background: rgba(198,40,40,0.1);
  transform: translate(1px, 1px);
  box-shadow: none;
}
