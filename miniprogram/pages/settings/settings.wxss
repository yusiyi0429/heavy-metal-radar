/* === 设置页 — Industrial Metal === */

.section {
  margin-top: 30px;
}

.section-title {
  font-size: 11px;
  font-weight: 900;
  color: #555555;
  letter-spacing: 6px;
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 1px solid #1e1e1e;
  position: relative;
}

/* 红色下划线短标 */
.section-title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 44px;
  height: 2px;
  background: linear-gradient(90deg, #c62828, transparent);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 14px;
}

.settings-tag {
  margin-right: 8px;
  margin-bottom: 8px;
  --td-tag-outline-bg-color: #111111;
  --td-tag-outline-border-color: #2a2a2a;
  --td-tag-text-color: #999999;
}

.add-row {
  display: flex;
  gap: 8px;
}

.add-input {
  flex: 1;
  --td-input-bg-color: #111111;
  --td-input-border-color: #2a2a2a;
  --td-input-text-color: #cccccc;
}

.add-input-inner {
  border: 1px solid #2a2a2a !important;
  box-shadow: 1px 2px 0 #000000;
}

.add-placeholder {
  color: #555;
}

.add-btn {
  --td-button-default-bg-color: #1a1a1a !important;
  --td-button-default-border-color: #2a2a2a !important;
  --td-button-default-color: #888888 !important;
  --td-button-border-radius: 0 !important;
  letter-spacing: 3px !important;
  font-weight: 800 !important;
  box-shadow: 2px 3px 0 #000000 !important;
}

.add-btn:active {
  --td-button-default-bg-color: #7f1d1d !important;
  --td-button-default-border-color: #7f1d1d !important;
  --td-button-default-color: #ffffff !important;
  transform: translate(1px, 1px) !important;
  box-shadow: 1px 1px 0 #000000 !important;
}

.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #0e0e0e;
  border: 1px solid #1e1e1e;
  box-shadow: 2px 3px 0 #000000;
  padding: 16px;
  font-size: 13px;
  font-weight: 700;
  color: #999999;
  letter-spacing: 1px;
}

.push-switch {
  --td-switch-checked-color: #c62828;
}

.save-btn {
  margin-top: 40px;
  --td-button-danger-bg-color: linear-gradient(180deg, #c62828, #8b1a1a) !important;
  --td-button-danger-border-color: #7f1d1d !important;
  --td-button-danger-color: #eeeeee !important;
  --td-button-border-radius: 0 !important;
  letter-spacing: 6px !important;
  font-weight: 900 !important;
  box-shadow: 4px 4px 0 #000000 !important;
}

.save-btn:active {
  --td-button-danger-bg-color: #991b1b !important;
  transform: translate(2px, 2px) !important;
  box-shadow: 1px 1px 0 #000000 !important;
}

.danger-btn {
  margin-top: 14px;
  --td-button-default-bg-color: transparent !important;
  --td-button-default-border-color: #4a1515 !important;
  --td-button-default-color: #c62828 !important;
  --td-button-border-radius: 0 !important;
  letter-spacing: 4px !important;
  font-weight: 800 !important;
  box-shadow: 2px 3px 0 #000000 !important;
}

.danger-btn:active {
  --td-button-default-bg-color: rgba(198,40,40,0.1) !important;
  transform: translate(1px, 1px) !important;
  box-shadow: none !important;
}
