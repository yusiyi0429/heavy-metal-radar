<view class="card-wrap">
  <view class="card-head">
    <text class="card-artist">{{show.artist || show.title}}</text>
    <t-tag
      t-class="status-tag"
      theme="primary"
      size="small"
      variant="dark"
      style="background: {{statusColor}}; border-color: {{statusColor}};"
    >
      {{statusLabel}}
    </t-tag>
  </view>
  <view class="card-info">
    <text class="card-city">{{show.city}}</text>
    <text class="card-divider">|</text>
    <text class="card-venue">{{show.venue}}</text>
  </view>
  <view class="card-time">{{show.date}}</view>
  <view class="card-foot">
    <view class="card-platform">
      <text>{{platformEmojiText}} {{platformLabelText}}</text>
    </view>
    <t-button
      t-class="card-buy"
      theme="danger"
      size="extra-small"
      variant="base"
      bindtap="onBuy"
    >
      购票
    </t-button>
  </view>
</view>
