<view class="card-wrap">
  <view class="card-head">
    <text class="card-artist">{{show.artist || show.title}}</text>
    <view class="card-status" style="background: {{statusInfo().color}}">
      {{statusInfo().label}}
    </view>
  </view>
  <view class="card-info">
    <text class="card-city">{{show.city}}</text>
    <text class="card-divider">|</text>
    <text class="card-venue">{{show.venue}}</text>
  </view>
  <view class="card-time">{{show.date}}</view>
  <view class="card-foot">
    <view class="card-platform">
      <text>{{platformEmoji()}} {{platformLabel()}}</text>
    </view>
    <view class="card-buy" bindtap="onBuy">购票</view>
  </view>
</view>
