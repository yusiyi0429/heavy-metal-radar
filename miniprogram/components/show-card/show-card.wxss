/* === 演出卡片 — Distressed Metal Card === */

.card-wrap {
  position: relative;
  margin-bottom: 14px;
  background: #0e0e0e;
  border: 1px solid #1e1e1e;
  box-shadow: 2px 3px 0 #000000;
  padding: 16px;
  overflow: hidden;
}

/* 左侧血红竖条 */
.card-wrap::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background: linear-gradient(180deg, #3a1010 0%, #c62828 20%, #ef4444 45%, #c62828 70%, #3a1010 100%);
}

/* 顶部金属拉丝线 */
.card-wrap::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, #3a3a3a 25%, #6a6a6a 50%, #3a3a3a 75%, transparent 100%);
  opacity: 0.7;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10px;
}

.card-artist {
  font-size: 17px;
  font-weight: 900;
  color: #e6e6e6;
  letter-spacing: 0.5px;
  flex: 1;
  line-height: 1.3;
  text-shadow: 2px 2px 0 rgba(0,0,0,0.9);
}

.card-status {
  flex-shrink: 0;
  margin-left: 12px;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 3px;
  padding: 3px 9px;
  color: #ffffff;
  box-shadow: 2px 2px 0 #000000;
}

.card-info {
  display: flex;
  align-items: center;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 6px;
}

.card-city {
  color: #d97706;
  letter-spacing: 1px;
}

.card-divider {
  color: #2a2a2a;
  margin: 0 8px;
}

.card-venue {
  color: #777777;
  letter-spacing: 0.3px;
}

.card-time {
  font-size: 11px;
  font-weight: 700;
  color: #555555;
  letter-spacing: 2px;
  margin-bottom: 14px;
}

.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10px;
  border-top: 1px solid #1a1a1a;
  position: relative;
}

/* 分割线上方的血红线 */
.card-foot::before {
  content: '';
  position: absolute;
  top: -1px;
  left: 0;
  right: 35%;
  height: 1px;
  background: linear-gradient(90deg, #7f1d1d, transparent);
}

.card-platform {
  font-size: 10px;
  font-weight: 600;
  color: #555555;
  letter-spacing: 2px;
}

.card-buy {
  background: linear-gradient(180deg, #c62828, #8b1a1a);
  border: 1px solid #7f1d1d;
  box-shadow: 2px 2px 0 #000000;
  color: #eeeeee;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 4px;
  padding: 5px 16px;
  text-shadow: 1px 1px 0 rgba(0,0,0,0.6);
}

.card-buy:active {
  background: #991b1b;
  transform: translate(1px, 1px);
  box-shadow: none;
}
